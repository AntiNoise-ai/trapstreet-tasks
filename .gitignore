.trap/

# Python venvs anywhere in the tree
**/.venv/

# Local-only PII files for the tenancy_agreement task.
# Tracked:  AST_Issue_1_CanaryWharf.pdf (sanitised) + gold.candidates.json
# Ignored:  everything under the per-task archive/ folder + any *_Original.pdf
tasks/pdf_reader/tenancy_agreement/archive/
tasks/pdf_reader/tenancy_agreement/*_Original.pdf
.pytest_cache/

# ─── LOCAL-ONLY tasks (license / IP risks — MUST NOT commit) ───
